{
  "name": "huixiang-recall-cards",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/generate-assets.mjs && vite build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply recall-cards --remote",
    "deploy": "npm run build && wrangler deploy",
    "test": "node .qa/interactions.cjs && node .qa/backend.mjs && node .qa/vercel.mjs"
  },
  "dependencies": {
    "dompurify": "3.2.7",
    "drizzle-orm": "0.44.5",
    "marked": "15.0.12"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "0.2.0",
    "drizzle-kit": "0.31.4",
    "jsdom": "26.1.0",
    "vite": "8.2.2",
    "wrangler": "^4.131.1"
  }
}
